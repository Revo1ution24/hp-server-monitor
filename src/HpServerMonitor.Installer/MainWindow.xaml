<Window x:Class="HpServerMonitor.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HP Server Monitor 安装向导"
        Width="940" Height="700" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI, Microsoft YaHei"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFDFB" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,0,0,1" Padding="30,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="HP" FontSize="14" FontWeight="Bold" Foreground="#2A211D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HP Server Monitor" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="图形化安装与配置" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StepLabel" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden"
               Background="Transparent" Focusable="False" />

        <Border x:Name="Footer" Grid.Row="2" Background="#FFFDFB"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="30,14">
            <Grid>
                <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="480"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="Cancel_Click" />
                    <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" Click="Back_Click" Visibility="Collapsed" />
                    <Button x:Name="NextButton" Content="下一步" Style="{StaticResource PrimaryButton}"
                            Click="Next_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
