<Page x:Class="HpServerMonitor.Installer.RuntimePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="运行方式">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,26,40,26">

            <TextBlock Text="运行方式" Style="{StaticResource H1Text}" FontSize="22" />
            <TextBlock Text="决定程序如何随系统启动，以及要不要顺手配置 HTTPS 入口。"
                       Style="{StaticResource MutedText}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="启动方式" Style="{StaticResource H2Text}" />
                    <RadioButton x:Name="ServiceRadio" GroupName="Mode" IsChecked="True"
                                 Content="Windows 服务（推荐）：开机自启、崩溃自动重启、以 LocalSystem 读取传感器" />
                    <RadioButton x:Name="TaskRadio" GroupName="Mode"
                                 Content="开机计划任务：同样以最高权限启动，不占用服务管理器" />
                    <RadioButton x:Name="FilesOnlyRadio" GroupName="Mode"
                                 Content="仅复制文件：不自动启动，稍后手动运行 HpServerMonitor.exe（调试用）" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="附加选项" Style="{StaticResource H2Text}" />
                    <CheckBox x:Name="FirewallCheck" IsChecked="True"
                              Content="为监听端口添加 Windows 防火墙入站规则（仅专用网络）" />
                    <CheckBox x:Name="OpenBrowserCheck" IsChecked="True"
                              Content="安装完成后自动打开浏览器" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="反向代理与 HTTPS（可选）" Style="{StaticResource H2Text}" />
                    <CheckBox x:Name="CaddyCheck" Click="CaddyCheck_Click"
                              Content="安装并接管 Caddy：自动下载官方程序、注册为 Windows 服务、配置 HTTPS" />

                    <StackPanel x:Name="CaddyOptions" IsEnabled="False" Margin="24,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="对外域名" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                                <TextBox x:Name="DomainBox" Style="{StaticResource FieldTextBox}"
                                         Text="monitor.example.com" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="HTTPS 端口" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                                <TextBox x:Name="HttpsPortBox" Style="{StaticResource FieldTextBox}"
                                         Text="443" Width="96" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Caddy 安装目录" Style="{StaticResource MutedText}" Margin="0,12,0,5" />
                        <TextBox x:Name="CaddyDirBox" Style="{StaticResource FieldTextBox}"
                                 HorizontalAlignment="Left" Width="360" />

                        <TextBlock Text="证书验证方式" Style="{StaticResource MutedText}" Margin="0,14,0,6" />
                        <RadioButton x:Name="CertAutoRadio" GroupName="Cert" IsChecked="True"
                                     Click="CertMode_Click"
                                     Content="自动（HTTP-01 / TLS-ALPN-01）：需要运营商放行 80/443 入站" />
                        <RadioButton x:Name="CertDnsRadio" GroupName="Cert" Click="CertMode_Click"
                                     Content="DNS-01（dynv6）：不依赖 80/443，适合家宽被封端口" />
                        <RadioButton x:Name="CertInternalRadio" GroupName="Cert" Click="CertMode_Click"
                                     Content="自签名 tls internal：内网可用，浏览器会提示不受信任" />

                        <StackPanel x:Name="DnsPanel" IsEnabled="False" Margin="0,8,0,0">
                            <TextBlock Text="dynv6 API Token" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                            <PasswordBox x:Name="TokenBox" Style="{StaticResource FieldPasswordBox}"
                                         HorizontalAlignment="Left" Width="360" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="在 dynv6 账户页面生成。Token 会写入安装目录的 Caddyfile，安装器会把该文件权限收紧为仅 SYSTEM / Administrators 可读。" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0"
                                   Text="未安装 Caddy 时会从 caddyserver.com 下载官方 caddy.exe（约 50 MB，需要联网）；选择 DNS-01 时会下载带 dynv6 插件的构建。检测到已有 Caddy 服务时，只把本站点追加进它的 Caddyfile 并重载，不改动其他站点。" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
