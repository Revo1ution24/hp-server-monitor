<Page x:Class="HpServerMonitor.Installer.UninstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="卸载">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,26,40,26">

            <TextBlock Text="卸载 / 修复" Style="{StaticResource H1Text}" FontSize="22" />
            <TextBlock Text="会停止并删除 HpServerMonitor 服务或计划任务，然后清理程序文件。想修复请直接返回重新安装。"
                       Style="{StaticResource MutedText}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="安装目录" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox" Style="{StaticResource FieldTextBox}" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Padding="16,7" Click="Browse_Click" />
                    </Grid>

                    <CheckBox x:Name="KeepDataCheck" IsChecked="True" Margin="0,14,0,0"
                              Content="保留 config.json 与 logs（以后重新安装可继续使用）" />
                    <CheckBox x:Name="FirewallCheck" IsChecked="True"
                              Content="同时移除 Windows 防火墙规则" />
                    <CheckBox x:Name="CaddyCheck" IsChecked="True"
                              Content="同时回退 Caddy 配置（移除追加的站点块 / 删除安装器创建的 Caddy 服务，Caddy 程序保留）" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Background="#FFF8EC" BorderBrush="#F0D9AC">
                <TextBlock Style="{StaticResource MutedText}" Foreground="#7A5A20"
                           Text="卸载不会改动路由器端口映射、Caddy 程序文件和 PawnIO 驱动，这些需要你按需手动清理。" />
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="UninstallButton" Content="开始卸载" Style="{StaticResource DangerButton}"
                        Margin="0,0,10,0" Click="Uninstall_Click" />
                <Button x:Name="BackButton" Content="返回安装向导" Style="{StaticResource SecondaryButton}"
                        Click="Back_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Margin="0,14,0,0" />

            <TextBox x:Name="LogBox" Style="{StaticResource MonoTextBox}" Height="180"
                     Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</Page>
