<Page x:Class="HpServerMonitor.Installer.ConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="基础配置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,26,40,26">

            <TextBlock Text="基础配置" Style="{StaticResource H1Text}" FontSize="22" />
            <TextBlock Text="安装位置、监听地址与登录账号。"
                       Style="{StaticResource MutedText}" Margin="0,5,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="安装目录" Style="{StaticResource FieldLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox" Style="{StaticResource FieldTextBox}" />
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}"
                                Margin="10,0,0,0" Padding="16,7" Click="Browse_Click" />
                    </Grid>
                    <TextBlock Text="程序、config.json 与日志都会放在这里，默认 C:\HpServerMonitor。"
                               Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="监听地址" Style="{StaticResource FieldLabel}" />
                    <RadioButton x:Name="LoopbackRadio" GroupName="Bind" IsChecked="True"
                                 Content="仅本机 127.0.0.1（推荐：由 Caddy / Nginx 反向代理对外提供 HTTPS）" />
                    <RadioButton x:Name="AnyRadio" GroupName="Bind"
                                 Content="所有网卡 0.0.0.0（局域网直连；公网只映射 443/80，不要映射本端口）" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HTTP 端口" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Style="{StaticResource BodyText}" />
                        <TextBox x:Name="PortBox" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                 Text="8080" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="管理员账号" Style="{StaticResource FieldLabel}" />

                    <TextBlock Text="用户名" Style="{StaticResource MutedText}" Margin="0,2,0,5" />
                    <TextBox x:Name="UserBox" Style="{StaticResource FieldTextBox}" Text="admin"
                             HorizontalAlignment="Left" Width="320" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="密码" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                            <PasswordBox x:Name="PwdBox" Style="{StaticResource FieldPasswordBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="确认密码" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                            <PasswordBox x:Name="ConfirmBox" Style="{StaticResource FieldPasswordBox}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="PasswordHint" Style="{StaticResource MutedText}" Margin="0,7,0,0" />

                    <Button Content="生成随机密码" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,7"
                            Click="Generate_Click" />

                    <Border x:Name="GeneratedPanel" Visibility="Collapsed" Background="#F3FBF5"
                            BorderBrush="#BFE3CC" BorderThickness="1" CornerRadius="9"
                            Padding="12,10" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="已生成随机密码，请立即记录" FontSize="12.5"
                                       Foreground="#2F7D4F" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GeneratedBox" IsReadOnly="True"
                                         Style="{StaticResource FieldTextBox}" FontFamily="Consolas" />
                                <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButton}"
                                        Margin="10,0,0,0" Padding="14,7" Click="Copy_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" />
        </StackPanel>
    </ScrollViewer>
</Page>
