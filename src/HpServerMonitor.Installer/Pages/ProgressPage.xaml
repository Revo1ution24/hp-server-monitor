<Page x:Class="HpServerMonitor.Installer.ProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent" Title="安装">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,26,40,26">

            <TextBlock x:Name="TitleText" Text="正在安装" Style="{StaticResource H1Text}" FontSize="22" />
            <TextBlock x:Name="SubtitleText" Text="正在释放文件并注册服务，请勿关闭窗口。"
                       Style="{StaticResource MutedText}" Margin="0,5,0,14" />

            <ProgressBar x:Name="Bar" Height="6" IsIndeterminate="True" BorderThickness="0"
                         Background="#EFE4DA" Foreground="{StaticResource AccentBrush}" />

            <TextBox x:Name="LogBox" Style="{StaticResource MonoTextBox}" Height="210"
                     Margin="0,14,0,14" />

            <Border x:Name="SummaryCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="访问信息" Style="{StaticResource H2Text}" />

                    <TextBlock Text="访问地址" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox x:Name="UrlBox" Style="{StaticResource FieldTextBox}" IsReadOnly="True"
                             HorizontalAlignment="Left" Width="440" />

                    <TextBlock Text="用户名" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                    <TextBox x:Name="UserNameBox" Style="{StaticResource FieldTextBox}" IsReadOnly="True"
                             HorizontalAlignment="Left" Width="220" />

                    <StackPanel x:Name="PasswordRow" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="随机密码（只显示这一次）" Style="{StaticResource MutedText}"
                                   Margin="0,0,0,4" />
                        <Grid HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="440" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GeneratedBox" Style="{StaticResource FieldTextBox}"
                                     IsReadOnly="True" FontFamily="Consolas" />
                            <Button Grid.Column="1" Content="复制" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Padding="14,7" Click="Copy_Click" />
                        </Grid>
                    </StackPanel>

                    <TextBlock x:Name="HealthText" Style="{StaticResource MutedText}" Margin="0,14,0,0" />
                    <TextBlock x:Name="CaddyText" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border x:Name="FailureCard" Visibility="Collapsed" Background="#FDF2F2"
                    BorderBrush="#F0C9C9" BorderThickness="1" CornerRadius="12"
                    Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="安装未完成" FontWeight="SemiBold" Foreground="#B23A3A"
                               Margin="0,0,0,6" />
                    <TextBlock x:Name="FailureText" Style="{StaticResource MutedText}"
                               Foreground="#8C3B3B" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="OpenSiteButton" Content="打开 Web 页面" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,10,0" Click="OpenSite_Click" />
                <Button x:Name="OpenFolderButton" Content="打开安装目录" Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0" Click="OpenFolder_Click" />
                <Button x:Name="CloseButton" Content="完成" Style="{StaticResource SecondaryButton}"
                        Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
