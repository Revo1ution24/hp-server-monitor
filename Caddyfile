# HpServerMonitor - Caddy 2 reverse proxy
# Kestrel listens on http://<server.bind>:8080 (default 0.0.0.0).
# If Caddy runs on the same machine, set server.bind = 127.0.0.1 and keep this target.
# Caddy terminates TLS and forwards WebSocket automatically.

monitor.example.com {
    encode gzip

    reverse_proxy 127.0.0.1:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        X-XSS-Protection "0"
        -Server
    }

    # Access log to stdout. Change to a file block if your Caddy has a log directory.
    log
}

# If monitor.example.com cannot obtain a publicly trusted certificate, use one of:
#   1. a real public domain + Let's Encrypt;
#   2. a Cloudflare Origin Certificate;
#   3. tls internal (only for a lab, and install Caddy's root CA on clients).
#
# Example for a lab:
# monitor.example.com {
#     tls internal
#     reverse_proxy 127.0.0.1:8080
# }
